# Copy to .env on the server only. Never commit .env or .dev.vars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STUDIO_ACCESS_TOKEN=
ALLOWED_ORIGINS=https://jobsff.github.io
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
MAX_JOBS_PER_DAY=30
RETENTION_DAYS=7
UPSTREAM_TIMEOUT_MS=180000
# Model IDs are explicitly chosen by the administrator, not guessed as latest.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Optional administrator-approved OpenAI Images compatible endpoint.
COMPAT_API_KEY=
COMPAT_MODEL=
COMPAT_BASE_URL=
COMPAT_EDIT_ENABLED=false
COMPAT_OPAQUE_PARAMETER=false
COMPAT_B64_RESPONSE=true
# Exact trusted CDN hostnames only, comma-separated. Redirects are never followed.
IMAGE_DOWNLOAD_HOSTS=
